[
  {
    "id": 1,
    "start": 0.133,
    "end": 1.933,
    "text": "强烈建议想系统性提升自己"
  },
  {
    "id": 2,
    "start": 1.933,
    "end": 3.966,
    "text": "想赚钱又不知道从哪下手的兄弟"
  },
  {
    "id": 3,
    "start": 3.966,
    "end": 5.566,
    "text": "去试试油管大神Dan Koe"
  },
  {
    "id": 4,
    "start": 5.566,
    "end": 7.833,
    "text": "提出的human3.0人生进化框架"
  },
  {
    "id": 5,
    "start": 7.833,
    "end": 9.166,
    "text": "帮你把混乱的成长"
  },
  {
    "id": 6,
    "start": 9.166,
    "end": 10.366,
    "text": "理成清晰的升级路径"
  },
  {
    "id": 7,
    "start": 10.4,
    "end": 12.566,
    "text": "这套模型核心就是把人生拆解成"
  },
  {
    "id": 8,
    "start": 12.566,
    "end": 15.7,
    "text": "心智、身体、精神、事业四个核心象限"
  },
  {
    "id": 9,
    "start": 15.7,
    "end": 17.466,
    "text": "帮你给自己做一次全面盘点"
  },
  {
    "id": 10,
    "start": 17.5,
    "end": 19.3,
    "text": "每个象限都从L1到L3"
  },
  {
    "id": 11,
    "start": 19.3,
    "end": 20.766,
    "text": "划分出清晰的成长等级"
  },
  {
    "id": 12,
    "start": 20.766,
    "end": 23.033,
    "text": "再基于层级制定针对性的成长规划"
  },
  {
    "id": 13,
    "start": 23.366,
    "end": 24.8,
    "text": "实现更完满的成长状态"
  },
  {
    "id": 14,
    "start": 24.8,
    "end": 25.766,
    "text": "用法很简单"
  },
  {
    "id": 15,
    "start": 25.766,
    "end": 27.366,
    "text": "只需要直接把human3.0的"
  },
  {
    "id": 16,
    "start": 27.366,
    "end": 29.133,
    "text": "结构化提示词发给大模型"
  },
  {
    "id": 17,
    "start": 29.2,
    "end": 31.566,
    "text": "AI根据四个象限分别做基础定级"
  },
  {
    "id": 18,
    "start": 31.566,
    "end": 33.9,
    "text": "再用深度采访的形式层层递进追问"
  },
  {
    "id": 19,
    "start": 33.9,
    "end": 35.2,
    "text": "一步步挖到你真实的"
  },
  {
    "id": 20,
    "start": 35.2,
    "end": 36.633,
    "text": "想法和隐藏的成长卡点"
  },
  {
    "id": 21,
    "start": 36.733,
    "end": 38.5,
    "text": "只要你回答的足够具体真诚"
  },
  {
    "id": 22,
    "start": 38.5,
    "end": 39.933,
    "text": "跟着问题一步步梳理"
  },
  {
    "id": 23,
    "start": 39.933,
    "end": 42.366,
    "text": "最终得到的专属成长模型和进化指南"
  },
  {
    "id": 24,
    "start": 42.4,
    "end": 43.966,
    "text": "往往会超出你的预期"
  },
  {
    "id": 25,
    "start": 43.966,
    "end": 45.133,
    "text": "很多人做完才发现"
  },
  {
    "id": 26,
    "start": 45.466,
    "end": 46.533,
    "text": "迷茫不是没答案"
  },
  {
    "id": 27,
    "start": 46.533,
    "end": 48.2,
    "text": "是从没被人系统的问过"
  },
  {
    "id": 28,
    "start": 48.2,
    "end": 49.7,
    "text": "你最想先升级哪一项"
  },
  {
    "id": 29,
    "start": 49.866,
    "end": 52.466,
    "text": "心智、身体、精神还是事业？"
  },
  {
    "id": 30,
    "start": 52.666,
    "end": 53.633,
    "text": "评论区报个名"
  },
  {
    "id": 31,
    "start": 53.666,
    "end": 55.866,
    "text": "关注我带你了解更多AI新玩法"
  }
]
